{
	"schemaVersion": 1,
	"id": "toolbelt",
	"version": "${version}",
	"name": "Toolbelt",
	"description": "Adds five persistent, tool-specific inventory slots.",
	"authors": [
		"phantomica"
	],
	"contact": {
		"homepage": "https://github.com/phantomica/fabricmod-toolbelt",
